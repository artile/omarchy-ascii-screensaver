#!/usr/bin/env bash
# Symlink ascii-screensaver into ~/.local/bin and seed the config file.
# Run once after `omarchy plugin add` if you want the CLI on PATH.
# install.sh already does this for the PATH-hook install path.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LOCAL_BIN="${XDG_BIN_HOME:-$HOME/.local/bin}"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-ascii-screensaver"

mkdir -p "$LOCAL_BIN" "$CFG_DIR"
ln -sfn "$ROOT/bin/ascii-screensaver" "$LOCAL_BIN/ascii-screensaver"
if [[ ! -f $CFG_DIR/config && -f $ROOT/config.example ]]; then
  cp -a "$ROOT/config.example" "$CFG_DIR/config"
fi
echo "Linked: $LOCAL_BIN/ascii-screensaver -> $ROOT/bin/ascii-screensaver"
echo "Config: $CFG_DIR/config"
